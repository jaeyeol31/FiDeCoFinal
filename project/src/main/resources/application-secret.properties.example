# application-secret.properties
# ⚠️  이 파일은 .gitignore에 포함됩니다. 절대 Git에 올리지 마세요!
# 이 파일을 복사해서 application-secret.properties 로 이름을 바꾼 뒤 실제 값을 입력하세요.

# -----------------------------------------------
# Database settings
# Oracle DB 연결 정보
# -----------------------------------------------
spring.datasource.url=jdbc:log4jdbc:oracle:thin:@127.0.0.1:1521:xe
spring.datasource.username=your_db_username
spring.datasource.password=your_db_password

# -----------------------------------------------
# Email settings
# Gmail 사용 시: Google 계정 > 보안 > 2단계 인증 > 앱 비밀번호에서 발급
# -----------------------------------------------
spring.mail.username=your_gmail@gmail.com
spring.mail.password=your_gmail_app_password

# -----------------------------------------------
# Kakao OAuth2 API settings
# https://developers.kakao.com 에서 앱 생성 후 발급
# -----------------------------------------------
spring.security.oauth2.client.registration.kakao.client-id=your_kakao_client_id
spring.security.oauth2.client.registration.kakao.client-secret=your_kakao_client_secret

# -----------------------------------------------
# Naver OAuth2 API settings
# https://developers.naver.com 에서 앱 생성 후 발급
# -----------------------------------------------
spring.security.oauth2.client.registration.naver.client-id=your_naver_client_id
spring.security.oauth2.client.registration.naver.client-secret=your_naver_client_secret

# -----------------------------------------------
# JWT Secret Key
# 충분히 길고 랜덤한 문자열을 사용하세요 (32자 이상 권장)
# -----------------------------------------------
secret-key=your_jwt_secret_key_here
